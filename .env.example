# SmartFuel Uzbekistan Environment Configuration

# Database (Default uses project root SQLite smartfuel.db; or PostgreSQL)
DATABASE_URL=sqlite:///./smartfuel.db
# For PostgreSQL:
# DATABASE_URL=postgresql://smartfuel_user:smartfuel_secure_password_2026@localhost:5432/smartfuel_db

# Security & JWT
SECRET_KEY=super-secret-production-key-smartfuel-uzbekistan-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Assistant (Optional - Pluggable OpenAI or Gemini API Keys)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
